# Puerto de escucha del servicio HTTP
PORT=8080

# Cadena de conexión a PostgreSQL 16+
DATABASE_URL=postgres://payments_user:payments_pass@localhost:5432/payments_db?sslmode=disable

# URL del simulador adquirente bancario
ACQUIRER_BASE_URL=http://localhost:8081

# Límite máximo de monto por transacción en CLP
PAYMENT_MAX_AMOUNT_CLP=10000000

# Nivel de logging estructurado (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
