# ==============================================================================
# Haulmer Payment Gateway - Root Environment Configuration
# ==============================================================================

# PostgreSQL 16 Database
POSTGRES_USER=payments_user
POSTGRES_PASSWORD=payments_pass
POSTGRES_DB=payments_db
POSTGRES_PORT=5432

# Acquirer Mock Service
ACQUIRER_PORT=8081

# Payments Central API
API_PORT=8080
PAYMENT_MAX_AMOUNT_CLP=10000000
LOG_LEVEL=INFO

# Web Dashboard & Sandbox
DASHBOARD_PORT=3000
